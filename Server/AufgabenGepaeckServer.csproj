<Project Sdk="Microsoft.NET.Sdk">

  <!-- Server-Teil des Aufgaben-Gepaecks: legt beim Serverstart den
       Quest Case an (eigener Behaelter fuer den Sicherheitsbehaelter). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AufgabenGepaeckServer</AssemblyName>
    <RootNamespace>AufgabenGepaeckServer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.3.0</Version>
    <NoWarn>$(NoWarn);CS1701;CS1702;NU1701</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/nvmegames/Games/SPT-416</GameDir>
    <ServerDir Condition="'$(ServerDir)' == ''">$(GameDir)/SPT_Runtime</ServerDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- HttpContext (fuer das Nachziehen bei der ersten Client-Anfrage)
       kommt aus ASP.NET Core, das der Server mitbringt. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(ServerDir)/SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(ServerDir)/SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(ServerDir)/SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(ServerDir)/SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Nur mit -p:Installieren=true kopieren, sonst ueberschreibt schon ein
       Probebau die eingebaute Fassung. questcase.json nur, wenn dort noch
       keine liegt - sonst waeren die Einstellungen nach jedem Bau weg. -->
  <Target Name="InsSpiel" AfterTargets="Build" Condition="'$(Installieren)' == 'true'">
    <MakeDir Directories="$(ServerDir)/user/mods/AufgabenGepaeck" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerDir)/user/mods/AufgabenGepaeck" />
    <Copy SourceFiles="questcase.json" DestinationFolder="$(ServerDir)/user/mods/AufgabenGepaeck"
          Condition="!Exists('$(ServerDir)/user/mods/AufgabenGepaeck/questcase.json')" />
    <Message Importance="high" Text="-> user/mods/AufgabenGepaeck/ (Server neu starten)" />
  </Target>

</Project>
